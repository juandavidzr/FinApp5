<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Clientes"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Clientes"
             xmlns:local="clr-namespace:FinApp5.ViewModels"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <local:BaseViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Estilos modernos basados en el diseño HTML -->
            <Style x:Key="MainContainer" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="30"/>
                <Setter Property="Margin" Value="20"/>
            </Style>

            <Style x:Key="HeaderLabel" TargetType="Label">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#2d3436"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,30"/>
            </Style>

            <Style x:Key="FormLabel" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#2d3436"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="#2d3436"/>
                <Setter Property="PlaceholderColor" Value="#636e72"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
                <Setter Property="Visual" Value="Material"/>
            </Style>

            <Style x:Key="ModernPicker" TargetType="Picker">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="#2d3436"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
                <Setter Property="Visual" Value="Material"/>
            </Style>

            <Style x:Key="LocationCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#fdcb6e"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,25,0,25"/>
            </Style>

            <Style x:Key="WhatsAppCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#25D366"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,25,0,25"/>
            </Style>

            <Style x:Key="CardLabel" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>

            <Style x:Key="CardFieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="CardEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="#2d3436"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="CardPicker" TargetType="Picker">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="#2d3436"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#667eea"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Visual" Value="Material"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="#667eea"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BorderColor" Value="#667eea"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="#fdcb6e"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="BackButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="#667eea"/>
                <Setter Property="BorderColor" Value="#667eea"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Fondo con gradiente -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0.0" />
            <GradientStop Color="#764ba2" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView Padding="20">
        <Grid>
            <Frame Style="{StaticResource MainContainer}">
                <StackLayout>

                    <!-- Header con botón de regreso y avatar -->
                    <StackLayout>
                        <Button x:Name="btnInicio" 
                                Text="← Ir a menú principal" 
                                Style="{StaticResource BackButton}"
                                Clicked="btnInicio_Clicked"/>

                        <StackLayout HorizontalOptions="Center" Margin="0,0,0,30">
                            <Frame BackgroundColor="#ffeaa7" 
                                   WidthRequest="60" 
                                   HeightRequest="60" 
                                   CornerRadius="30" 
                                   HasShadow="True"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,15">
                                <Label Text="FA" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       TextColor="#2d3436"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <Label Style="{StaticResource HeaderLabel}" Text="Registro de Cliente"/>
                        </StackLayout>
                    </StackLayout>

                    <!-- Formulario Principal -->
                    <StackLayout>
                        <!-- Número de Identificación -->
                        <Label Style="{StaticResource FormLabel}" Text="Número de identificación" />
                        <Entry Text="{Binding TxtId}" 
                               x:Name="TxtId" 
                               Style="{StaticResource ModernEntry}"
                               Unfocused="TxtId_Unfocused"/>

                        <!-- Nombre Completo -->
                        <Label Style="{StaticResource FormLabel}" Text="Nombre Completo" />
                        <Entry x:Name="TxtNombre" 
                               Text="{Binding TxtNombre}" 
                               Style="{StaticResource ModernEntry}"
                               Focused="Nombre_Focused"/>

                        <!-- Dirección de Domicilio -->
                        <Label Style="{StaticResource FormLabel}" Text="Dirección de domicilio"/>
                        <Entry x:Name="TxtDirDomicilio" 
                               Text="{Binding TxtDirDomicilio}" 
                               Style="{StaticResource ModernEntry}"/>

                        <!-- Barrio de Domicilio -->
                        <Label Style="{StaticResource FormLabel}" Text="Barrio de domicilio"/>
                        <Picker x:Name="cmbBarrioDom" 
                                Style="{StaticResource ModernPicker}"
                                Title="Seleccione el barrio de Domicilio" 
                                ItemsSource="{Binding Barrios}"
                                ItemDisplayBinding="{Binding NombreBarrio}"
                                SelectedItem="{Binding IdBarrio}"
                                FontAutoScalingEnabled="False"
                                SelectedIndexChanged="cmbBarrioDom_SelectedIndexChanged"/>
                        <Label x:Name="TxtBarrioDom" FontSize="12" TextColor="#636e72" Margin="0,-15,0,15"/>

                        <!-- Tarjeta de Ubicación de Cobro -->
                        <Frame Style="{StaticResource LocationCard}">
                            <StackLayout>
                                <Label Style="{StaticResource CardLabel}" Text="📍 Ubicación de Cobro"/>

                                <Label Style="{StaticResource CardFieldLabel}" Text="Dirección de cobro"/>
                                <Entry x:Name="TxtDirCobro" 
                                       Text="{Binding TxtDirCobro}" 
                                       Style="{StaticResource CardEntry}"/>

                                <Label Style="{StaticResource CardFieldLabel}" Text="Barrio de Cobro"/>
                                <Picker x:Name="cmbBarrioCobro" 
                                        Style="{StaticResource CardPicker}"
                                        Title="Seleccione el barrio de cobro" 
                                        ItemsSource="{Binding Barrios}"
                                        ItemDisplayBinding="{Binding NombreBarrio}"
                                        SelectedItem="{Binding IdBarrio}"
                                        FontAutoScalingEnabled="False"
                                        SelectedIndexChanged="cmbBarrioCobro_SelectedIndexChanged"/>
                                <Label x:Name="TxtBarrioCobro" 
                                       Style="{StaticResource CardFieldLabel}" 
                                       FontSize="10" 
                                       Margin="0,-10,0,10"/>

                                <!-- Coordenadas en dos columnas -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,0,0,15">
                                    <StackLayout Grid.Column="0">
                                        <Label Style="{StaticResource CardFieldLabel}" Text="Latitud"/>
                                        <Entry x:Name="TxtLatitud" 
                                               Text="{Binding TxtLatitud}" 
                                               Style="{StaticResource CardEntry}"
                                               IsReadOnly="True"
                                               Placeholder="0.000000"
                                               Margin="0"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="1">
                                        <Label Style="{StaticResource CardFieldLabel}" Text="Longitud"/>
                                        <Entry x:Name="TxtLongitud" 
                                               Text="{Binding TxtLongitud}" 
                                               Style="{StaticResource CardEntry}"
                                               IsReadOnly="True" 
                                               Placeholder="0.000000"
                                               Margin="0"/>
                                    </StackLayout>
                                </Grid>

                                <!-- Botones de Ubicación -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0" 
                                            Text="📍 Cargar ubicación" 
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding BtnUbicacionCommand}"/>
                                    <Button Grid.Column="1" 
                                            Text="🧭 Navegar" 
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding BtnNavegarCommand}"/>
                                </Grid>
                            </StackLayout>
                        </Frame>

                        <!-- Sección WhatsApp -->
                        <Frame Style="{StaticResource WhatsAppCard}">
                            <StackLayout>
                                <Label Style="{StaticResource CardLabel}" Text="📱 WhatsApp"/>
                                <Label Style="{StaticResource CardFieldLabel}" Text="Teléfono 1"/>
                                <Entry x:Name="TxtTelefono1" 
                                       Text="{Binding TxtTelefono1}" 
                                       Style="{StaticResource CardEntry}"
                                       Keyboard="Telephone"
                                       Margin="0,0,0,10"/>
                                <Button Text="WhatsApp" 
                                        BackgroundColor="White"
                                        TextColor="#25D366"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="35"
                                        Command="{Binding BtnWhatsAppCommand}"/>
                            </StackLayout>
                        </Frame>

                        <!-- Teléfono 2 -->
                        <Label Style="{StaticResource FormLabel}" Text="Teléfono 2" />
                        <Entry x:Name="TxtTelefono2" 
                               Text="{Binding TxtTelefono2}" 
                               Style="{StaticResource ModernEntry}"
                               Keyboard="Telephone"/>

                        <!-- Notas Generales -->
                        <Label Style="{StaticResource FormLabel}" Text="Notas Generales" />
                        <Entry x:Name="TxtNotas" 
                               Text="{Binding TxtNotas}" 
                               Style="{StaticResource ModernEntry}"
                               Placeholder="Información adicional..."/>

                        <!-- Botones de Acción -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,30,0,0">
                            <Button Grid.Column="0" 
                                    x:Name="BtnLimpiar" 
                                    Text="Limpiar" 
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="BtnLimpiar_Clicked"/>
                            <Button Grid.Column="1" 
                                    x:Name="BtnGuardar" 
                                    Text="Guardar" 
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="Button_Clicked_Guardar"/>
                        </Grid>
                    </StackLayout>
                </StackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>