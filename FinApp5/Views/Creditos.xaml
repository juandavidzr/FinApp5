<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Creditos"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="false">

    <Grid>
        <!-- Fondo con gradiente de morado a blanco -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6B63C6" Offset="0.0" />
                    <GradientStop Color="#9B94D8" Offset="0.25" />
                    <GradientStop Color="#C4C0E8" Offset="0.5" />
                    <GradientStop Color="#E8E6F5" Offset="0.75" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Contenido principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Avatar Section -->
            <StackLayout Grid.Row="0" Padding="0,30,0,10" HorizontalOptions="Center">
                <Frame WidthRequest="80" HeightRequest="80" CornerRadius="40" 
                       BackgroundColor="White" Padding="0" HasShadow="True"
                       BorderColor="#ffffff" Margin="0,0,0,5">
                    <Label Text="FA" FontSize="28" FontAttributes="Bold" 
                           TextColor="#5b64c3" HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"/>
                </Frame>
            </StackLayout>

            <!-- Title -->
            <Label Grid.Row="1" Text="Nuevo Crédito" 
                   TextColor="White" FontSize="24" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" Margin="0,0,0,10"/>

            <!-- Container blanco para contenido -->
            <Frame Grid.Row="2" CornerRadius="35" Padding="0" 
                   BackgroundColor="White" HasShadow="True"
                   Margin="0,0,0,0">

                <ScrollView Margin="0" Scrolled="OnScrollViewScrolled" SizeChanged="OnScrollViewSizeChanged">
                    <StackLayout Padding="20">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTapGestureRecognizerTapped"/>
                        </StackLayout.GestureRecognizers>

                        <!-- Título Sección Cliente -->
                        <Label Text="Información de el cliente" 
                               FontSize="18" FontAttributes="Bold" 
                               TextColor="#5b64c3" 
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,15"/>

                        <!-- Información del Cliente -->
                        <Grid RowSpacing="10" ColumnSpacing="10" Margin="0,0,0,20" VerticalOptions="Start">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ID Cliente -->
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="Id Cliente:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="0" Grid.Column="1" 
                                   x:Name="txtidCliente" 
                                   FontSize="16" 
                                   Text=""
                                   BackgroundColor="#f1f5f9"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Start"
                                   IsEnabled="False"/>

                            <!-- Nombre -->
                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="Nombre:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="1" Grid.Column="1" 
                                   x:Name="txtNombreCli" 
                                   FontSize="16"
                                   Text=""
                                   BackgroundColor="#f1f5f9"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Start"
                                   IsEnabled="False"/>

                            <!-- Créditos Vigentes -->
                            <Label Grid.Row="2" Grid.Column="0" 
                                   Text="Creditos Vigentes:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="2" Grid.Column="1" 
                                   x:Name="txtCreditos" 
                                   FontSize="16"
                                   Text=""
                                   BackgroundColor="#f1f5f9"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Start"
                                   IsEnabled="False"/>

                            <!-- Deuda Total -->
                            <Label Grid.Row="3" Grid.Column="0" 
                                   Text="Deuda total: $" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="3" Grid.Column="1" 
                                   x:Name="txtDeuda" 
                                   FontSize="16" 
                                   Text="0"
                                   TextColor="#dc2626"
                                   FontAttributes="Bold"
                                   BackgroundColor="#fee2e2"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="End"
                                   IsEnabled="False"/>

                            <!-- Fecha Último Crédito -->
                            <Label Grid.Row="4" Grid.Column="0" 
                                   Text="Fecha Ultimo Credito:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="4" Grid.Column="1" 
                                   x:Name="txtFechaUltimo" 
                                   FontSize="16"
                                   Text=""
                                   BackgroundColor="#f1f5f9"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Start"
                                   IsEnabled="False"/>

                            <!-- Valor Último Crédito -->
                            <Label Grid.Row="5" Grid.Column="0" 
                                   Text="Valor ultimo credito: $" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="5" Grid.Column="1" 
                                   x:Name="txtValorUltimo" 
                                   FontSize="16"
                                   Text="0"
                                   BackgroundColor="#f1f5f9"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="End"
                                   IsEnabled="False"/>

                            <!-- Fecha Último Abono -->
                            <Label Grid.Row="6" Grid.Column="0" 
                                   Text="Fecha ultimo abono:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="6" Grid.Column="1" 
                                   x:Name="txtUltimoPago" 
                                   FontSize="16"
                                   Text=""
                                   BackgroundColor="#f1f5f9"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Start"
                                   IsEnabled="False"/>
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" BackgroundColor="#e2e8f0" Margin="0,10,0,20"/>

                        <!-- Título Sección Crédito -->
                        <Label Text="Información del credito" 
                               FontSize="18" FontAttributes="Bold" 
                               TextColor="#5b64c3" 
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,15"/>

                        <!-- Información del Crédito -->
                        <Grid RowSpacing="10" ColumnSpacing="10" Margin="0,0,0,20" VerticalOptions="Start">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Desembolso -->
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="Desembolso: $" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="0" Grid.Column="1" 
                                   x:Name="txtDesembolso" 
                                   FontSize="16" 
                                   Text="0" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White"
                                   TextColor="#0f172a"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Start"
                                   VerticalTextAlignment="Center"/>

                            <!-- Interés -->
                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="Interes (%):" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="1" Grid.Column="1" 
                                   x:Name="txtInteres" 
                                   FontSize="16" 
                                   Text="20" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White"
                                   VerticalOptions="Start"
                                   VerticalTextAlignment="Center"/>

                            <!-- Tiempo en días -->
                            <Label Grid.Row="2" Grid.Column="0" 
                                   Text="Tiempo en dias:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="2" Grid.Column="1" 
                                   x:Name="txtTiempo" 
                                   FontSize="16" 
                                   Text="30" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White"
                                   VerticalOptions="Start"/>

                            <!-- Plazo -->
                            <Label Grid.Row="3" Grid.Column="0" 
                                   Text="Plazo:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Picker Grid.Row="3" Grid.Column="1" 
                                    x:Name="cmbPlazo" 
                                    ItemsSource="{Binding plazoList}"
                                    ItemDisplayBinding="{Binding nombrePlazo}"
                                    SelectedItem="{Binding idPlazo}"
                                    SelectedIndexChanged="cmbPlazo_SelectedIndexChanged"
                                    FontSize="16"
                                    BackgroundColor="White"
                                    VerticalOptions="Start"
                                    Title="--Seleccione el plazo--"/>

                            <!-- Día de Pago -->
                            <Label Grid.Row="4" Grid.Column="0" 
                                   Text="Dia de pago:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Picker Grid.Row="4" Grid.Column="1" 
                                    x:Name="cmbDias"
                                    ItemsSource="{Binding diasList}"
                                    ItemDisplayBinding="{Binding nombreDia}"
                                    SelectedItem="{Binding idDia}"
                                    SelectedIndexChanged="cmbDias_SelectedIndexChanged"
                                    FontSize="16"
                                    BackgroundColor="White"
                                    Title="--Seleccione el dia de pago--"/>

                            <!-- Guía de Pago -->
                            <Label Grid.Row="5" Grid.Column="0" 
                                   Text="Guia de pago:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="5" Grid.Column="1" 
                                   x:Name="txtGuiaPago" 
                                   FontSize="16"
                                   Text=""
                                   BackgroundColor="White"
                                   VerticalOptions="Start"/>

                            <!-- Posición -->
                            <Label Grid.Row="6" Grid.Column="0" 
                                   Text="Posicion:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Picker Grid.Row="6" Grid.Column="1" 
                                    x:Name="cmbPosicion"
                                    FontSize="16"
                                    ItemsSource="{Binding rutaList}"
                                    ItemDisplayBinding="{Binding nombreCliente}"
                                    SelectedItem="{Binding posicion}"
                                    SelectedIndexChanged="cmbPosicion_SelectedIndexChanged"
                                    BackgroundColor="White"
                                    Title="-- Seleccione una posicion --"/>

                            <!-- Notas -->
                            <Label Grid.Row="7" Grid.Column="0" 
                                   Text="Notas:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="7" Grid.Column="1" 
                                   x:Name="txtNotas" 
                                   FontSize="16"
                                   Text=""
                                   BackgroundColor="White"
                                   VerticalOptions="Start"/>

                            <!-- Fecha Crédito -->
                            <Label Grid.Row="8" Grid.Column="0" 
                                   Text="Fecha credito:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <DatePicker Grid.Row="8" Grid.Column="1" 
                                        x:Name="txtFechaNuevoCre" 
                                        FontSize="16"
                                        BackgroundColor="White"
                                        VerticalOptions="Start"
                                        IsEnabled="False"/>
                        </Grid>

                        <!-- Grid vacío (mantenido del original) -->
                        <Grid VerticalOptions="Start">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- Botón Grabar -->
                        <Button x:Name="btnGrabar" 
                                Grid.Row="0" 
                                Grid.Column="1" 
                                Text="Grabar" 
                                Clicked="btnGrabar_Clicked"
                                BackgroundColor="#5b64c3"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                Padding="0,15"
                                CornerRadius="25"
                                HeightRequest="55"
                                Margin="0,10,0,20"/>

                    </StackLayout>
                </ScrollView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>