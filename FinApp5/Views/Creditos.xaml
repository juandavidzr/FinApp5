<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Creditos"
             Title="Creditos">

    <ScrollView Scrolled="OnScrollViewScrolled" SizeChanged="OnScrollViewSizeChanged">
        <Grid>
            <!-- Fondo con gradiente de morado a blanco -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#6B63C6" Offset="0.0" />
                        <GradientStop Color="#9B94D8" Offset="0.25" />
                        <GradientStop Color="#C4C0E8" Offset="0.5" />
                        <GradientStop Color="#E8E6F5" Offset="0.75" />
                        <GradientStop Color="#FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <VerticalStackLayout Spacing="0" Padding="0">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTapGestureRecognizerTapped"/>
                </VerticalStackLayout.GestureRecognizers>

                <!-- Header Section -->
                <VerticalStackLayout Padding="20,30,20,30" Spacing="15">
                    <Label Text="Gestión de Créditos"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#2D2760"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Complete la información del crédito"
                           FontSize="14"
                           TextColor="#2D2760"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Content -->
                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Información del Cliente Card -->
                    <Frame BackgroundColor="White"
                           CornerRadius="20"
                           Padding="25"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="18">
                            <Label Text="👤 Información del Cliente"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#495057"
                                   Margin="0,0,0,10"/>

                            <!-- ID Cliente -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ID Cliente"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#495057"/>
                                <Entry x:Name="txtidCliente"
                                       FontSize="16"
                                       TextColor="#212529"
                                       BackgroundColor="Transparent"
                                       IsEnabled="False"/>
                                <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                            </VerticalStackLayout>

                            <!-- Nombre -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nombre"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#495057"/>
                                <Entry x:Name="txtNombreCli"
                                       FontSize="16"
                                       TextColor="#212529"
                                       BackgroundColor="Transparent"
                                       IsEnabled="False"/>
                                <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                            </VerticalStackLayout>

                            <!-- Grid para Créditos y Deuda -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="Créditos Vigentes"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#495057"/>
                                    <Entry x:Name="txtCreditos"
                                           FontSize="16"
                                           TextColor="#212529"
                                           BackgroundColor="Transparent"
                                           IsEnabled="False"/>
                                    <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="Deuda Total"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#495057"/>
                                    <Entry x:Name="txtDeuda"
                                           Text="0"
                                           FontSize="16"
                                           TextColor="#f03e3e"
                                           BackgroundColor="Transparent"
                                           IsEnabled="False"/>
                                    <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Fecha Último Crédito -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Fecha Último Crédito"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#495057"/>
                                <Entry x:Name="txtFechaUltimo"
                                       FontSize="16"
                                       TextColor="#212529"
                                       BackgroundColor="Transparent"
                                       IsEnabled="False"/>
                                <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                            </VerticalStackLayout>

                            <!-- Grid para Valor y Fecha Pago -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="Valor Último Crédito"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#495057"/>
                                    <Entry x:Name="txtValorUltimo"
                                           Text="0"
                                           FontSize="16"
                                           TextColor="#212529"
                                           BackgroundColor="Transparent"
                                           IsEnabled="False"/>
                                    <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="Fecha Último Abono"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#495057"/>
                                    <Entry x:Name="txtUltimoPago"
                                           FontSize="16"
                                           TextColor="#212529"
                                           BackgroundColor="Transparent"
                                           IsEnabled="False"/>
                                    <BoxView HeightRequest="2" Color="#e9ecef" HorizontalOptions="Fill"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Información del Crédito Card -->
                    <Frame CornerRadius="20"
                           Padding="25"
                           HasShadow="True">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7950f2" Offset="0.0" />
                                <GradientStop Color="#5f3dc4" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>

                        <VerticalStackLayout Spacing="18">
                            <Label Text="💰 Información del Crédito"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   Margin="0,0,0,10"/>

                            <!-- Desembolso -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Desembolso"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="16,14"
                                       HasShadow="False">
                                    <Entry x:Name="txtDesembolso"
                                           Text="0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#212529"
                                           BackgroundColor="Transparent"
                                           Keyboard="Numeric"
                                           Placeholder="Ingrese el monto"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Grid para Interés y Tiempo -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="Interés (%)"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           Opacity="0.95"/>
                                    <Frame BackgroundColor="#FFFFFFEF"
                                           BorderColor="Transparent"
                                           CornerRadius="12"
                                           Padding="16,14"
                                           HasShadow="False">
                                        <Entry x:Name="txtInteres"
                                               Text="20"
                                               FontSize="16"
                                               TextColor="#212529"
                                               BackgroundColor="Transparent"
                                               Keyboard="Numeric"/>
                                    </Frame>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="Tiempo (días)"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           Opacity="0.95"/>
                                    <Frame BackgroundColor="#FFFFFFEF"
                                           BorderColor="Transparent"
                                           CornerRadius="12"
                                           Padding="16,14"
                                           HasShadow="False">
                                        <Entry x:Name="txtTiempo"
                                               Text="30"
                                               FontSize="16"
                                               TextColor="#212529"
                                               BackgroundColor="Transparent"
                                               Keyboard="Numeric"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Plazo -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Plazo"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="10,8"
                                       HasShadow="False">
                                    <Picker x:Name="cmbPlazo"
                                            FontSize="16"
                                            TextColor="#495057"
                                            BackgroundColor="Transparent"
                                            Title="Seleccione el plazo"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Día de Pago -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Día de Pago"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="10,8"
                                       HasShadow="False">
                                    <Picker x:Name="cmbDias"
                                            FontSize="16"
                                            TextColor="#495057"
                                            BackgroundColor="Transparent"
                                            Title="Seleccione el día de pago"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Guía de Pago -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Guía de Pago"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="16,14"
                                       HasShadow="False">
                                    <Entry x:Name="txtGuiaPago"
                                           FontSize="16"
                                           TextColor="#212529"
                                           BackgroundColor="Transparent"
                                           Placeholder="Información adicional"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Posición -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Posición"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="10,8"
                                       HasShadow="False">
                                    <Picker x:Name="cmbPosicion"
                                            FontSize="16"
                                            TextColor="#495057"
                                            BackgroundColor="Transparent"
                                            Title="Seleccione una posición"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Notas -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Notas"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="16,14"
                                       HasShadow="False">
                                    <Entry x:Name="txtNotas"
                                           FontSize="16"
                                           TextColor="#212529"
                                           BackgroundColor="Transparent"
                                           Placeholder="Observaciones"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Fecha Crédito -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Fecha del Crédito"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Opacity="0.95"/>
                                <Frame BackgroundColor="#FFFFFFEF"
                                       BorderColor="Transparent"
                                       CornerRadius="12"
                                       Padding="16,14"
                                       HasShadow="False">
                                    <DatePicker x:Name="txtFechaNuevoCre"
                                                FontSize="16"
                                                TextColor="#212529"
                                                BackgroundColor="Transparent"/>
                                </Frame>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Botón Grabar -->
                    <Button x:Name="btnGrabar"
                            Text="💾 Grabar Crédito"
                            Clicked="btnGrabar_Clicked"
                            BackgroundColor="#5f3dc4"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="60"
                            Margin="0,10,0,30"/>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>