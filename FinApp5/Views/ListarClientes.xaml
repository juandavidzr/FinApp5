<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.ListarClientes"
             Title="Clientes para crédito"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Fondo con gradiente -->
        <BoxView Grid.RowSpan="2">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#667eea" Offset="0.0" />
                    <GradientStop Color="#764ba2" Offset="0.3" />
                    <GradientStop Color="#f0f4ff" Offset="0.8" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- CONTENIDO SUPERIOR -->
        <StackLayout Grid.Row="0"
                     Padding="20,30,20,10"
                     Spacing="20">

           
            <!-- Botones -->
            <Button x:Name="btnInicio"
                    Text="← Ir a menú principal"
                    Clicked="btnInicio_Clicked"
                    BackgroundColor="White"
                    TextColor="#667eea"
                    BorderColor="#667eea"
                    BorderWidth="2"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontSize="14"
                    HorizontalOptions="Center"
                    WidthRequest="250" />

            <Button x:Name="btnTransacciones"
                    Text="Ir a Transacciones"
                    Clicked="btnTransacciones_Clicked"
                    BackgroundColor="White"
                    TextColor="#667eea"
                    BorderColor="#667eea"
                    BorderWidth="2"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontSize="14"
                    HorizontalOptions="Center"
                    WidthRequest="250" />

            <!-- Título -->
            <Label Text="Clientes para Crédito"
                   HorizontalTextAlignment="Center"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#2d3748" />

            <!-- Search -->
            <Frame BackgroundColor="White"
                   CornerRadius="25"
                   HasShadow="True"
                   Padding="5">
                <SearchBar x:Name="searchBar"
                           Placeholder="Buscar por nombre"
                           TextChanged="SearchBar_TextChanged"
                           SearchButtonPressed="SearchBar_SearchButtonPressed"
                           MaxLength="30"
                           FontSize="15"
                           BackgroundColor="Transparent"
                           CancelButtonColor="#667eea"
                           PlaceholderColor="#a0aec0"
                           TextColor="#4a5568" />
            </Frame>

            <!-- Encabezados -->
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="0">

                <Grid Padding="15" BackgroundColor="#e5e7eb">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <StackLayout Grid.Column="0">
                        <Label Text="ID CLIENTE" FontAttributes="Bold" FontSize="11" />
                        <Label Text="TELÉFONO" FontAttributes="Bold" FontSize="11" />
                    </StackLayout>

                    <StackLayout Grid.Column="1">
                        <Label Text="NOMBRE CLIENTE" FontAttributes="Bold" FontSize="11" />
                        <Label Text="DIRECCIÓN" FontAttributes="Bold" FontSize="11" />
                    </StackLayout>
                </Grid>
            </Frame>

        </StackLayout>

        <!-- LISTA (fila * → clave para iOS) -->
        <Frame Grid.Row="1"
               Margin="20,0,20,20"
               BackgroundColor="White"
               CornerRadius="20"
               HasShadow="True"
               Padding="0">

            <ListView x:Name="cvClientes"
                      ItemSelected="lstClientes_ItemSelected"
                      HasUnevenRows="True"
                      SeparatorColor="#f3f4f6"
                      BackgroundColor="White"
                      VerticalOptions="FillAndExpand"
                       >

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="15" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0">
                                    <Label Text="{Binding cteNumIdenti}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding cteTeleCelu}"
                                           FontSize="12"
                                           TextColor="#fbbf24" />
                                </StackLayout>

                                <StackLayout Grid.Column="1">
                                    <Label Text="{Binding cteNombApel}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding cteDirCobCte}"
                                           FontSize="11"
                                           TextColor="#a0aec0"
                                           LineBreakMode="WordWrap" />
                                </StackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Frame>

    </Grid>
</ContentPage>
