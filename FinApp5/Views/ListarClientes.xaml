<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.ListarClientes"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="false">

    <Grid>
        <!-- Fondo con gradiente de morado a blanco -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6B63C6" Offset="0.0" />
                    <GradientStop Color="#9B94D8" Offset="0.25" />
                    <GradientStop Color="#C4C0E8" Offset="0.5" />
                    <GradientStop Color="#E8E6F5" Offset="0.75" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Contenido principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Avatar Section -->
            <StackLayout Grid.Row="0" Padding="0,40,0,15" HorizontalOptions="Center">
                <Frame WidthRequest="100" HeightRequest="100" CornerRadius="50" 
                       BackgroundColor="White" Padding="0" HasShadow="True"
                       BorderColor="#ffffff" Margin="0,0,0,10">
                    <Label Text="FA" FontSize="36" FontAttributes="Bold" 
                           TextColor="#5b64c3" HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"/>
                </Frame>
            </StackLayout>

            <!-- Title -->
            <Label Grid.Row="1" Text="Clientes para crédito" 
                   TextColor="White" FontSize="28" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" Margin="0,0,0,15"/>

            <!-- Botones -->
            <StackLayout Grid.Row="2" Spacing="12" Padding="20,0,20,0" Margin="0,0,0,20">
                <Button x:Name="btnTransacciones" 
                        Text="Ir a Transacciones" 
                        Clicked="btnTransacciones_Clicked"
                        BackgroundColor="#5b64c3"
                        TextColor="White"
                        FontSize="16"
                        Padding="0,15"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        HeightRequest="50"/>
                <Button x:Name="btnInicio" 
                        Text="Ir a menú principal" 
                        Clicked="btnInicio_Clicked"
                        BackgroundColor="#5b64c3"
                        TextColor="White"
                        FontSize="16"
                        Padding="0,15"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        HeightRequest="50"/>
            </StackLayout>

            <!-- SearchBar -->
            <Frame Grid.Row="3" Padding="0" CornerRadius="25" 
                   BackgroundColor="White" BorderColor="#cbd5e1" 
                   HasShadow="False" Margin="20,0,20,15">
                <SearchBar Placeholder="Buscar por nombre" 
                           Keyboard="Chat"
                           TextChanged="SearchBar_TextChanged"
                           MaxLength="30"
                           FontSize="15"
                           Background="Transparent"
                           TextColor="#1e293b"
                           PlaceholderColor="#94a3b8"
                           CancelButtonColor="#64748b"/>
            </Frame>

            <!-- Container blanco para lista -->
            <Frame Grid.Row="4" CornerRadius="35" Padding="0" 
                   BackgroundColor="White" HasShadow="True"
                   Margin="0,0,0,0">

                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezados -->
                    <Grid Grid.Row="0" Padding="15,15,15,12" BackgroundColor="#f1f5f9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Fila 1 -->
                        <Label Text="ID CLIENTE" 
                               Grid.Row="0" Grid.Column="0" 
                               FontSize="10" TextColor="#64748b" FontAttributes="Bold"
                               HorizontalTextAlignment="Start" Margin="5,2"/>
                        <Label Text="NOMBRE CLIENTE" 
                               Grid.Row="0" Grid.Column="1" 
                               FontSize="10" TextColor="#64748b" FontAttributes="Bold"
                               HorizontalTextAlignment="Start" Margin="5,2"/>

                        <!-- Fila 2 -->
                        <Label Text="TELÉFONO" 
                               Grid.Row="1" Grid.Column="0" 
                               FontSize="10" TextColor="#64748b" FontAttributes="Bold"
                               HorizontalTextAlignment="Start" Margin="5,2"/>
                        <Label Text="DIRECCIÓN" 
                               Grid.Row="1" Grid.Column="1" 
                               FontSize="10" TextColor="#64748b" FontAttributes="Bold"
                               HorizontalTextAlignment="Start" Margin="5,2"/>
                    </Grid>

                    <!-- Lista -->
                    <ListView x:Name="cvClientes" 
                              Grid.Row="1"
                              ItemSelected="lstClientes_ItemSelected" 
                              HasUnevenRows="True" 
                              SeparatorVisibility="Default"
                              SeparatorColor="#e2e8f0"
                              BackgroundColor="White">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame Padding="0" Margin="15,6,15,6" 
                                           CornerRadius="12" 
                                           BackgroundColor="White"
                                           BorderColor="#e2e8f0"
                                           HasShadow="False">
                                        <Grid Padding="16,14" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Fila 1: ID Cliente y Nombre -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="4*"/>
                                                </Grid.ColumnDefinitions>

                                                <Label Text="{Binding cteNumIdenti}" 
                                                       Grid.Column="0"
                                                       TextColor="#3b82f6" FontSize="15" FontAttributes="Bold"
                                                       HorizontalTextAlignment="Start"
                                                       VerticalTextAlignment="Center"/>

                                                <Label Text="{Binding cteNombApel}" 
                                                       Grid.Column="1"
                                                       TextColor="#0f172a" FontSize="15" FontAttributes="Bold"
                                                       HorizontalTextAlignment="Start"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="WordWrap"/>
                                            </Grid>

                                            <!-- Fila 2: Teléfono y Dirección -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="4*"/>
                                                </Grid.ColumnDefinitions>

                                                <Label Text="{Binding cteTeleCelu}" 
                                                       Grid.Column="0"
                                                       TextColor="#ea580c" FontSize="13"
                                                       HorizontalTextAlignment="Start"
                                                       VerticalTextAlignment="Center"/>

                                                <Label Text="{Binding cteDirCobCte}" 
                                                       Grid.Column="1"
                                                       TextColor="#64748b" FontSize="13"
                                                       HorizontalTextAlignment="Start"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="WordWrap"/>
                                            </Grid>
                                        </Grid>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>