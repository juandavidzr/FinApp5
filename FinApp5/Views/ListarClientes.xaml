<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.ListarClientes"
             Title="Clientes para crédito"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <ScrollView>
            <Grid>
                <!-- Fondo con gradiente -->
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#667eea" Offset="0.0" />
                            <GradientStop Color="#764ba2" Offset="0.3" />
                            <GradientStop Color="#f0f4ff" Offset="0.8" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <StackLayout Padding="20,30,20,20" Spacing="20">

                    <!-- Avatar circular con iniciales -->
                    <Frame WidthRequest="100"
                           HeightRequest="100"
                           CornerRadius="50"
                           BorderColor="#fbbf24"
                           HasShadow="True"
                           Padding="0"
                           HorizontalOptions="Center"
                           BackgroundColor="White">
                        <Label Text="FA"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="#4a1d96"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Frame>

                    <!-- Botón regresar al menú principal -->
                    <Button x:Name="btnInicio"
                            Text="← Ir a menú principal"
                            Clicked="btnInicio_Clicked"
                            BackgroundColor="White"
                            TextColor="#667eea"
                            BorderColor="#667eea"
                            BorderWidth="2"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="14"
                            HorizontalOptions="Center"
                            WidthRequest="250" />

                    <!-- Título -->
                    <Label Text="Clientes para Crédito"
                           HorizontalTextAlignment="Center"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#2d3748"
                           Margin="0,10,0,10" />

                    <!-- Barra de búsqueda con SearchBar original -->
                    <Frame BackgroundColor="White"
                           CornerRadius="25"
                           HasShadow="True"
                           Padding="5"
                           Margin="0,0,0,10">
                        <SearchBar x:Name="searchBar"
                                   Placeholder="Buscar por nombre"
                                   Keyboard="Chat"
                                   TextChanged="SearchBar_TextChanged"
                                   MaxLength="30"
                                   FontSize="15"
                                   BackgroundColor="Transparent"
                                   CancelButtonColor="#667eea"
                                   PlaceholderColor="#a0aec0"
                                   TextColor="#4a5568" />
                    </Frame>

                    <!-- Contenedor de la lista con sombra -->
                    <Frame BackgroundColor="White"
                           CornerRadius="20"
                           HasShadow="True"
                           Padding="0"
                           Margin="0">

                        <StackLayout Spacing="0">
                            <!-- Encabezados -->
                            <Grid Padding="15,15,15,15" BackgroundColor="#e5e7eb">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Primera columna -->
                                <StackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Spacing="2">
                                    <Label Text="ID CLIENTE" 
                                           FontAttributes="Bold" 
                                           FontSize="11" 
                                           TextColor="#374151" />
                                    <Label Text="TELÉFONO" 
                                           FontAttributes="Bold" 
                                           FontSize="11" 
                                           TextColor="#374151" />
                                </StackLayout>

                                <!-- Segunda columna -->
                                <StackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="2">
                                    <Label Text="NOMBRE CLIENTE" 
                                           FontAttributes="Bold" 
                                           FontSize="11" 
                                           TextColor="#374151" />
                                    <Label Text="DIRECCIÓN" 
                                           FontAttributes="Bold" 
                                           FontSize="11" 
                                           TextColor="#374151" />
                                </StackLayout>
                            </Grid>

                            <!-- Lista de clientes - MANTIENE FUNCIONALIDAD ORIGINAL -->
                            <ListView x:Name="cvClientes" 
                                      ItemSelected="lstClientes_ItemSelected" 
                                      HasUnevenRows="True" 
                                      SeparatorColor="#f3f4f6"
                                      SeparatorVisibility="Default"
                                      BackgroundColor="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid Padding="15,12" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Columna izquierda: ID y Teléfono -->
                                                <StackLayout Grid.Column="0" Spacing="3">
                                                    <Label Text="{Binding cteNumIdenti}" 
                                                           FontSize="13" 
                                                           TextColor="#4a5568" 
                                                           FontAttributes="Bold" />
                                                    <Label Text="{Binding cteTeleCelu}" 
                                                           FontSize="12" 
                                                           TextColor="#fbbf24" />
                                                </StackLayout>

                                                <!-- Columna derecha: Nombre y Dirección -->
                                                <StackLayout Grid.Column="1" Spacing="3">
                                                    <Label Text="{Binding cteNombApel}" 
                                                           FontSize="14" 
                                                           TextColor="#1a202c" 
                                                           FontAttributes="Bold"
                                                           LineBreakMode="WordWrap" />
                                                    <Label Text="{Binding cteDirCobCte}" 
                                                           FontSize="11" 
                                                           TextColor="#a0aec0" 
                                                           LineBreakMode="WordWrap" />
                                                </StackLayout>
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackLayout>
                    </Frame>

                    <!-- Botón para ir a Transacciones - MANTIENE FUNCIONALIDAD -->
                    <Button x:Name="btnTransacciones"
                            Text="Ir a Transacciones"
                            Clicked="btnTransacciones_Clicked"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="14"
                            TextColor="White"
                            HorizontalOptions="Center"
                            WidthRequest="250"
                            Margin="0,10,0,20">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#667eea" Offset="0.0" />
                                <GradientStop Color="#764ba2" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                </StackLayout>
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>