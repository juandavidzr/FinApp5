<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.SubMenuClientes"
             Title="SubMenuClientes"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="False">

    <!-- Fondo con gradiente -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3949AB" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="0.35" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <!-- Header con logo -->
            <RowDefinition Height="*" />
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Header con Logo -->
        <StackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Padding="20,50,20,30">
            <Border BackgroundColor="White" 
                    StrokeThickness="4" 
                    Stroke="#D4AF37" 
                    WidthRequest="70" 
                    HeightRequest="70"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="35" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="White" Opacity="0.4" Radius="12" Offset="0,12" />
                </Border.Shadow>
                <Label Text="FA" 
                       TextColor="Black" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>
        </StackLayout>

        <!-- Contenido Principal -->
        <StackLayout Grid.Row="1" Padding="25" Spacing="35">

            <!-- Botón de regreso -->
            <Border BackgroundColor="Transparent" 
                    StrokeThickness="2" 
                    Stroke="#3949AB" 
                    Padding="12,12"
                    HorizontalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>
                <Button x:Name="btnInicio" 
                        Text="← Menú Principal" 
                        Clicked="btnInicio_Clicked" 
                        BackgroundColor="Transparent"
                        TextColor="#3949AB"
                        FontSize="14"
                        FontAttributes="Bold"
                        BorderWidth="0">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                        <Setter Property="TextColor" Value="#3949AB"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#3949AB"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>
            </Border>

            <!-- Título de la sección -->
            <Label Text="Gestión de Clientes" 
                   TextColor="#2c3e50" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,0,0,25" />

            <!-- Card Principal con ícono -->
            <Border BackgroundColor="Transparent" 
                    StrokeThickness="2" 
                    Stroke="White" 
                    Padding="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B8860B" Offset="0.0" />
                        <GradientStop Color="#DAA520" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#B8860B" Opacity="0.3" Radius="15" Offset="0,15" />
                </Border.Shadow>

                <Grid>
                    <!-- Contenido visual con ícono -->
                    <StackLayout VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="10"
                                 InputTransparent="True">
                        <Label Text="👥 +" 
                               TextColor="White" 
                               FontSize="48" 
                               HorizontalTextAlignment="Center" />
                        <Label Text="Registrar Cliente" 
                               TextColor="White" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               HorizontalTextAlignment="Center" />
                    </StackLayout>

                    <!-- Button funcional invisible -->
                    <Button BorderColor="Transparent"
                            BorderWidth="0"
                            CornerRadius="25"
                            Padding="0"
                            IsEnabled="True"
                            Command="{Binding irAClientesCommand}" 
                            WidthRequest="180" 
                            HeightRequest="180" 
                            BackgroundColor="Transparent"
                            Text="">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent"/>
                                            <Setter Property="Scale" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent"/>
                                            <Setter Property="Scale" Value="0.95"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </Grid>
            </Border>

        </StackLayout>

        <!-- Elementos decorativos flotantes -->
        <Ellipse Grid.RowSpan="2" 
                 Fill="#FFFFFF" 
                 Opacity="0.1" 
                 WidthRequest="50" 
                 HeightRequest="50" 
                 HorizontalOptions="Start" 
                 VerticalOptions="Start" 
                 Margin="-10,60,0,0"
                 InputTransparent="True" />

        <Ellipse Grid.RowSpan="2" 
                 Fill="#FFFFFF" 
                 Opacity="0.1" 
                 WidthRequest="50" 
                 HeightRequest="50" 
                 HorizontalOptions="End" 
                 VerticalOptions="Start" 
                 Margin="0,180,-20,0"
                 InputTransparent="True" />

    </Grid>
</ContentPage><?xml version="1.0" encoding="utf-8" ?>
