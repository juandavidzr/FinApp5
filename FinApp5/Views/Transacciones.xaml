<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Transacciones"
             Title="Transacciones"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="False">

    <!-- Fondo con gradiente -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3949AB" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="0.35" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <!-- Header con logo -->
            <RowDefinition Height="*" />
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Header con Logo -->
        <StackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Padding="20,50,20,30">
            <Border BackgroundColor="White" 
                    StrokeThickness="4" 
                    Stroke="#D4AF37" 
                    WidthRequest="70" 
                    HeightRequest="70"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="35" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="White" Opacity="0.4" Radius="12" Offset="0,12" />
                </Border.Shadow>
                <Label Text="FA" 
                       TextColor="Black" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>
        </StackLayout>

        <!-- Contenido Principal -->
        <StackLayout Grid.Row="1" Padding="25" Spacing="25">

            <!-- Botón de regreso -->
            <Border BackgroundColor="Transparent" 
                    StrokeThickness="2" 
                    Stroke="#3949AB" 
                    Padding="12,12"
                    HorizontalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>
                <Button x:Name="btnInicio" 
                        Text="← Ir a menu principal" 
                        Clicked="btnInicio_Clicked" 
                        BackgroundColor="Transparent"
                        TextColor="#3949AB"
                        FontSize="14"
                        FontAttributes="Bold"
                        BorderWidth="0">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                        <Setter Property="TextColor" Value="#3949AB"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#3949AB"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>
            </Border>

            <!-- Título de la sección -->
            <Label Text="Transacciones" 
                   TextColor="#2c3e50" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,0,0,15" />

            <!-- Indicador de actividad -->
            <Grid IsVisible="{Binding IsBusy}" HorizontalOptions="Center">
                <ActivityIndicator x:Name="acti" HeightRequest="25" WidthRequest="25"
                        IsRunning="{Binding IsBusy}" Color="#3949AB" IsVisible="True" />
            </Grid>

            <!-- Cards de Transacciones en Grid 2x2 -->
            <Grid RowDefinitions="*,*"
                  ColumnDefinitions="*,*"
                  RowSpacing="15"
                  ColumnSpacing="15"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">

                <!-- Registrar Crédito -->
                <Border Grid.Row="0" Grid.Column="0" 
                        BackgroundColor="Transparent" 
                        StrokeThickness="0" 
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="160"
                        HeightRequest="140">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4CAF50" Offset="0.0" />
                            <GradientStop Color="#388E3C" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    

                    <Grid>
                        <StackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="6"
                                     >
                            <Label Text="💰" 
                                   TextColor="White" 
                                   FontSize="28" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Registrar Crédito" 
                                   TextColor="White" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>

                        <ImageButton Source="credito.png"
                                     Aspect="AspectFit"
                                     BorderColor="Transparent"
                                     BorderWidth="0"
                                     CornerRadius="15"
                                     Padding="0"
                                     IsEnabled="True"
                                     Command="{Binding ListarClientesCommand}" 
                                     BackgroundColor="Transparent"
                                     >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.95"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </ImageButton>
                    </Grid>
                </Border>

                <!-- Realizar Recaudo -->
                <Border Grid.Row="0" Grid.Column="1" 
                        BackgroundColor="Transparent" 
                        StrokeThickness="0" 
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="160"
                        HeightRequest="140">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F44336" Offset="0.0" />
                            <GradientStop Color="#C62828" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                   

                    <Grid>
                        <StackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="6"
                                     >
                            <Label Text="💵" 
                                   TextColor="White" 
                                   FontSize="28" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Realizar Recaudo" 
                                   TextColor="White" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>

                        <ImageButton Source="recaudo.png"
                                     Aspect="AspectFit"
                                     BorderColor="Transparent"
                                     BorderWidth="0"
                                     CornerRadius="15"
                                     Padding="0"
                                     IsEnabled="True"
                                     Command="{Binding ListarCreditosCommand}"
                                     Clicked="ImageButton_Clicked"
                                     BackgroundColor="Transparent"
                                     >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.95"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </ImageButton>
                    </Grid>
                </Border>

                <!-- Enrutar Cartera -->
                <Border Grid.Row="1" Grid.Column="0" 
                        BackgroundColor="Transparent" 
                        StrokeThickness="0" 
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="160"
                        HeightRequest="140">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF9800" Offset="0.0" />
                            <GradientStop Color="#F57C00" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                   

                    <Grid>
                        <StackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="6"
                                     >
                            <Label Text="📋" 
                                   TextColor="White" 
                                   FontSize="28" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Enrutar Cartera" 
                                   TextColor="White" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>

                        <ImageButton Source="enrutar.png"
                                     Aspect="AspectFit"
                                     BorderColor="Transparent"
                                     BorderWidth="0"
                                     CornerRadius="15"
                                     Padding="0"
                                     IsEnabled="True"
                                     Command="{Binding EnrrutarCommand}" 
                                     BackgroundColor="Transparent"
                                     >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.95"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </ImageButton>
                    </Grid>
                </Border>

                <!-- Registrar Gastos -->
                <Border Grid.Row="1" Grid.Column="1" 
                        BackgroundColor="Transparent" 
                        StrokeThickness="0" 
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="160"
                        HeightRequest="140">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#757575" Offset="0.0" />
                            <GradientStop Color="#424242" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    

                    <Grid>
                        <StackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="6"
                                     >
                            <Label Text="📊" 
                                   TextColor="White" 
                                   FontSize="28" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Registrar Gasto(s)" 
                                   TextColor="White" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>

                        <ImageButton Source="gastos.png"
                                     Aspect="AspectFit"
                                     BorderColor="Transparent"
                                     BorderWidth="0"
                                     CornerRadius="15"
                                     Padding="0"
                                     IsEnabled="True"
                                     Command="{Binding RegistarGastosCommand}" 
                                     BackgroundColor="Transparent"
                                     >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.95"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </ImageButton>
                    </Grid>
                </Border>

            </Grid>

        </StackLayout>

        <!-- Elementos decorativos flotantes -->
        <Ellipse Grid.RowSpan="2" 
                 Fill="#FFFFFF" 
                 Opacity="0.1" 
                 WidthRequest="50" 
                 HeightRequest="50" 
                 HorizontalOptions="Start" 
                 VerticalOptions="Start" 
                 Margin="-10,60,0,0"
                 />

        <Ellipse Grid.RowSpan="2" 
                 Fill="#FFFFFF" 
                 Opacity="0.1" 
                 WidthRequest="50" 
                 HeightRequest="50" 
                 HorizontalOptions="End" 
                 VerticalOptions="Start" 
                 Margin="0,180,-20,0"
                 />

    </Grid>
</ContentPage>