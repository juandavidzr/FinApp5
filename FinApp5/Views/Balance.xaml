<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Balance"
             Title="BALANCE">
    <ContentPage.Content>
        <Grid>
            <!-- Fondo con gradiente de morado a blanco -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#6B63C6" Offset="0.0" />
                        <GradientStop Color="#9B94D8" Offset="0.25" />
                        <GradientStop Color="#C4C0E8" Offset="0.5" />
                        <GradientStop Color="#E8E6F5" Offset="0.75" />
                        <GradientStop Color="#FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Contenido principal -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Avatar Section -->
                <StackLayout Grid.Row="0" Padding="0,40,0,20" HorizontalOptions="Center">
                    <Frame WidthRequest="100" HeightRequest="100" CornerRadius="50" 
                           BackgroundColor="White" Padding="0" HasShadow="True"
                           BorderColor="#ffffff" Margin="0,0,0,15">
                        <Label Text="FA" FontSize="36" FontAttributes="Bold" 
                               TextColor="#5b64c3" HorizontalTextAlignment="Center" 
                               VerticalTextAlignment="Center"/>
                    </Frame>
                </StackLayout>

                <!-- Title -->
                <Label Grid.Row="1" Text="Balance - Datos de Hoy" 
                       TextColor="White" FontSize="28" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" Margin="0,0,0,30"/>

                <!-- Container blanco -->
                <Frame Grid.Row="2" CornerRadius="35" Padding="0" 
                       BackgroundColor="White" HasShadow="True"
                       Margin="0,0,0,0">

                    <ScrollView>
                        <StackLayout Spacing="0">

                            <!-- Header con fecha y total -->
                            <Grid BackgroundColor="#eef2ff" Padding="25,25,25,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0">
                                    <Label Text="FECHA ACTUAL" FontSize="10" TextColor="#64748b" 
                                           FontAttributes="Bold" Margin="0,0,0,4"/>
                                    <Label x:Name="txtFecha" Text="{Binding TxtFecha}" 
                                           FontSize="20" FontAttributes="Bold" TextColor="#5b64c3"/>
                                </StackLayout>

                                <StackLayout Grid.Column="1" HorizontalOptions="End">
                                    <Label Text="TOTAL ACTUAL" FontSize="10" TextColor="#64748b" 
                                           FontAttributes="Bold" Margin="0,0,0,4"
                                           HorizontalTextAlignment="End"/>
                                    <Label x:Name="txtTotal" 
                                           Text="{Binding TxtTotal, StringFormat='${0:N0}'}"
                                           FontSize="20" FontAttributes="Bold" TextColor="#1e293b"
                                           HorizontalTextAlignment="End"/>
                                </StackLayout>
                            </Grid>

                            <!-- Sección: Cobros -->
                            <StackLayout Padding="20,15,20,10">
                                <Label Text="💰 COBROS" FontSize="11" TextColor="#64748b" 
                                       FontAttributes="Bold" Margin="0,0,0,10"/>

                                <!-- Debido cobrar ruta -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Debido cobrar ruta:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtDebidoRuta" 
                                               Text="{Binding TxtDebidoRuta, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#3b82f6"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Debido cobrar día -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Debido cobrar día:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtDebidoDia" 
                                               Text="{Binding TxtDebidoDia, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#3b82f6"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </StackLayout>

                            <!-- Sección: Movimientos -->
                            <StackLayout Padding="20,10,20,10">
                                <Label Text="📊 MOVIMIENTOS" FontSize="11" TextColor="#64748b" 
                                       FontAttributes="Bold" Margin="0,0,0,10"/>

                                <!-- Recaudos -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Recaudos:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtRecaudo" 
                                               Text="{Binding TxtRecaudo, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Microseguros -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Microseguros:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtMicroseguro" 
                                               Text="{Binding TxtMicroseguro, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Desembolsos -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Desembolsos:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtDesembolsos" 
                                               Text="{Binding TxtDesembolsos, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Gastos -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Gastos:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtGastos" 
                                               Text="{Binding TxtGastos, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Entradas -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Entradas de efectivo:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtEntradas" 
                                               Text="{Binding TxtEntradas, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Salidas -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Salidas de efectivo:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtSalidas" 
                                               Text="{Binding TxtSalidas, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <!-- Sueldos -->
                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" 
                                       BackgroundColor="White" BorderColor="#e2e8f0" HasShadow="False">
                                    <Grid Padding="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Sueldos:" 
                                               TextColor="#1e293b" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtSueldos" 
                                               Text="{Binding TxtSueldos, StringFormat='${0:N0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </StackLayout>

                            <!-- Sección: Resultado -->
                            <StackLayout Padding="20,10,20,10">
                                <Label Text="📈 RESULTADO" FontSize="11" TextColor="#64748b" 
                                       FontAttributes="Bold" Margin="0,0,0,10"/>

                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" HasShadow="False"
                                       BackgroundColor="#fff7ed" BorderColor="#fed7aa">
                                    <Grid Padding="18,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Resultado (ing-egr):" 
                                               TextColor="#1e293b" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtResultado" 
                                               Text="{Binding TxtResultado, StringFormat='${0:N0}'}"
                                               FontSize="18" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </StackLayout>

                            <!-- Sección: Balance Final -->
                            <StackLayout Padding="20,10,20,20">
                                <Label Text="💵 BALANCE FINAL" FontSize="11" TextColor="#64748b" 
                                       FontAttributes="Bold" Margin="0,0,0,10"/>

                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" HasShadow="False"
                                       BackgroundColor="#faf5ff" BorderColor="#e9d5ff">
                                    <Grid Padding="20,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Caja Anterior:" 
                                               TextColor="#1e293b" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtCajaAnterior" 
                                               Text="{Binding TxtCajaAnterior, StringFormat='${0:N0}'}"
                                               FontSize="22" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>

                                <Frame Padding="0" Margin="0,0,0,8" CornerRadius="0" BorderColor="#e9d5ff" HasShadow="False"
                                       BackgroundColor="#faf5ff">
                                    <Grid Padding="22,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Total Actual:" 
                                               TextColor="#1e293b" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="txtTotal2" 
                                               Text="{Binding TxtTotal, StringFormat='${0:N0}'}"
                                               FontSize="24" FontAttributes="Bold" TextColor="#1e293b"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </StackLayout>
                        </StackLayout>
                    </ScrollView>
                </Frame>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
