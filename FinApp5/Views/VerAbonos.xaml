<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.VerAbonos"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="false">

    <Grid>
        <!-- Fondo con gradiente de morado a blanco -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6B63C6" Offset="0.0" />
                    <GradientStop Color="#9B94D8" Offset="0.25" />
                    <GradientStop Color="#C4C0E8" Offset="0.5" />
                    <GradientStop Color="#E8E6F5" Offset="0.75" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Contenido principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Avatar Section -->
            <StackLayout Grid.Row="0" Padding="0,30,0,10" HorizontalOptions="Center">
                <Frame WidthRequest="80" HeightRequest="80" CornerRadius="40" 
                       BackgroundColor="White" Padding="0" HasShadow="True"
                       BorderColor="#ffffff" Margin="0,0,0,5">
                    <Label Text="FA" FontSize="28" FontAttributes="Bold" 
                           TextColor="#5b64c3" HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"/>
                </Frame>
            </StackLayout>

            <!-- Botón Volver -->
            <Button Grid.Row="1" x:Name="btnVolver" 
                    Text="Volver a Créditos" 
                    Clicked="btnVolver_Clicked"
                    BackgroundColor="#5b64c3"
                    TextColor="White"
                    FontSize="16"
                    Padding="0,12"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    HeightRequest="45"
                    Margin="20,0,20,10"/>

            <!-- Container blanco para contenido -->
            <Frame Grid.Row="2" CornerRadius="35" Padding="0" 
                   BackgroundColor="White" HasShadow="True"
                   Margin="0,0,0,0">

                <ScrollView Margin="0">
                    <StackLayout Padding="20" Spacing="15">

                        <!-- Título -->
                        <Label Text="Historial de Movimientos" 
                               FontSize="20" FontAttributes="Bold" 
                               TextColor="#5b64c3" 
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,10"/>

                        <!-- Encabezados de la lista -->
                        <Grid Padding="12,10" BackgroundColor="#f1f5f9" ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" 
                                   Text="FECHA" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="#64748b"
                                   HorizontalTextAlignment="Start"/>
                            <Label Grid.Column="1" 
                                   Text="VALOR" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="#64748b"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="2" 
                                   Text="TIPO" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="#64748b"
                                   HorizontalTextAlignment="Center"/>
                        </Grid>

                        <!-- Lista de Movimientos -->
                        <Frame Padding="0" 
                               CornerRadius="12" 
                               BorderColor="#e2e8f0"
                               HasShadow="False"
                               BackgroundColor="White">
                            <ListView x:Name="lstMovimientos" 
                                      SeparatorColor="#e2e8f0"
                                      HasUnevenRows="True"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Frame Padding="12,10" 
                                                   Margin="0,2" 
                                                   CornerRadius="8" 
                                                   BorderColor="Transparent"
                                                   BackgroundColor="White"
                                                   HasShadow="False">
                                                <Grid ColumnSpacing="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Fecha -->
                                                    <Label Grid.Column="0" 
                                                           Text="{Binding FechaHoraReg, StringFormat='{0:dd/MM/yyyy hh:mm tt}'}"  
                                                           TextColor="#0f172a"
                                                           FontSize="13"
                                                           VerticalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation"/>

                                                    <!-- Valor -->
                                                    <Label Grid.Column="1" 
                                                           Text="{Binding ValorMovto, StringFormat='${0:N0}'}"  
                                                           TextColor="#16a34a" 
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"/>

                                                    <!-- Tipo -->
                                                    <Frame Grid.Column="2"
                                                           Padding="6,4"
                                                           CornerRadius="10"
                                                           BackgroundColor="#dbeafe"
                                                           BorderColor="Transparent"
                                                           HasShadow="False"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding strCodTipMov}" 
                                                               TextColor="#1e40af"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center"/>
                                                    </Frame>
                                                </Grid>
                                            </Frame>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Frame>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" BackgroundColor="#e2e8f0" Margin="0,10,0,10"/>

                        <!-- Resumen de Totales -->
                        <Frame BackgroundColor="#f8fafc" 
                               CornerRadius="15" 
                               Padding="15" 
                               HasShadow="False" 
                               BorderColor="#e2e8f0">
                            <StackLayout Spacing="10">

                                <Label Text="RESUMEN" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#64748b"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,0,0,5"/>

                                <!-- Microseguros -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="Cantidad Microseguros:" 
                                           FontSize="15" 
                                           TextColor="#475569"
                                           VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           x:Name="lblCantidadMicroseguros" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           TextColor="#3b82f6"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="Total Microseguros:" 
                                           FontSize="15" 
                                           TextColor="#475569"
                                           VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           x:Name="lblTotalMicroseguros" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           TextColor="#3b82f6"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <!-- Separador interno -->
                                <BoxView HeightRequest="1" BackgroundColor="#e2e8f0" Margin="0,5"/>

                                <!-- Abonos -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="Cantidad Abonos:" 
                                           FontSize="15" 
                                           TextColor="#475569"
                                           VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           x:Name="lblCantidadAbonos" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           TextColor="#16a34a"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="Total Abonos:" 
                                           FontSize="15" 
                                           TextColor="#475569"
                                           VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           x:Name="lblTotalAbonos" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           TextColor="#16a34a"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <!-- Separador interno -->
                                <BoxView HeightRequest="2" BackgroundColor="#5b64c3" Margin="0,10,0,5"/>

                                <!-- Saldo Actual -->
                                <Grid ColumnSpacing="10" Padding="10,5" BackgroundColor="#eef2ff" Margin="-5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="Saldo Actual:" 
                                           FontSize="17" 
                                           FontAttributes="Bold"
                                           TextColor="#5b64c3"
                                           VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           x:Name="lblSaldoActual" 
                                           FontSize="19" 
                                           FontAttributes="Bold"
                                           TextColor="#dc2626"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                            </StackLayout>
                        </Frame>

                    </StackLayout>
                </ScrollView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
