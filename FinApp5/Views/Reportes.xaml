<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Reportes"
             Title="Reportes"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="False">

    <!-- Fondo con gradiente -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3949AB" Offset="0.0" />
                <GradientStop Color="#FFFFFF" Offset="0.35" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <!-- Header con logo -->
            <RowDefinition Height="*" />
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Header con Logo -->
        <StackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Padding="20,50,20,30">
            <Border BackgroundColor="White" 
                    StrokeThickness="4" 
                    Stroke="#D4AF37" 
                    WidthRequest="70" 
                    HeightRequest="70"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="35" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="White" Opacity="0.4" Radius="12" Offset="0,12" />
                </Border.Shadow>
                <Label Text="FA" 
                       TextColor="Black" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>
        </StackLayout>

        <!-- Contenido Principal -->
        <StackLayout Grid.Row="1" Padding="25,0,25,25" Spacing="15">

            <!-- Botón de regreso -->
            <Border x:Name="btnBack"
                    BackgroundColor="Transparent" 
                    StrokeThickness="2" 
                    Stroke="#3949AB" 
                    Padding="12,12"
                    HorizontalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>
                <Button x:Name="btnInicio" 
                        Text="← Ir a menu principal" 
                        Clicked="btnInicio_Clicked" 
                        BackgroundColor="Transparent"
                        TextColor="#3949AB"
                        FontSize="14"
                        FontAttributes="Bold"
                        BorderWidth="0">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                        <Setter Property="TextColor" Value="#3949AB"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#3949AB"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>
            </Border>

            <!-- Título de la sección -->
            <Label Text="Reportes" 
                   TextColor="#2c3e50" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,5,0,10" />

            <!-- Indicador de actividad -->
            <Grid IsVisible="{Binding IsBusy}" HorizontalOptions="Center">
                <ActivityIndicator HeightRequest="25" WidthRequest="25"
                        IsRunning="{Binding IsBusy}" Color="#3949AB" IsVisible="True" />
            </Grid>

            <!-- Cards de Reportes en columna vertical -->
            <StackLayout Spacing="15"
                         HorizontalOptions="Center"
                         VerticalOptions="Start">

                <!-- Informe Día -->
                <Border x:Name="cardInformeDia"
                        BackgroundColor="Transparent" 
                        StrokeThickness="0" 
                        Padding="0"
                        HorizontalOptions="Center"
                        WidthRequest="320"
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrAInformeDiaCommand}" Tapped="OnCardTapped_InformeDia" />
                    </Border.GestureRecognizers>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#9333ea" Offset="0.0" />
                            <GradientStop Color="#7e22ce" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#9333ea" Opacity="0.3" Radius="8" Offset="0,4" />
                    </Border.Shadow>

                    <StackLayout VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="6">
                        <Label Text="📄" 
                               TextColor="White" 
                               FontSize="28" 
                               HorizontalTextAlignment="Center" />
                        <Label Text="Informe Día" 
                               TextColor="White" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Border>

                <!-- Balance Actual -->
                <Border x:Name="cardBalanceActual"
                        BackgroundColor="Transparent" 
                        StrokeThickness="0" 
                        Padding="0"
                        HorizontalOptions="Center"
                        WidthRequest="320"
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrABalanceActualCommand}" Tapped="OnCardTapped_BalanceActual" />
                    </Border.GestureRecognizers>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3b82f6" Offset="0.0" />
                            <GradientStop Color="#2563eb" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#3b82f6" Opacity="0.3" Radius="8" Offset="0,4" />
                    </Border.Shadow>

                    <StackLayout VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="6">
                        <Label Text="📊" 
                               TextColor="White" 
                               FontSize="28" 
                               HorizontalTextAlignment="Center" />
                        <Label Text="Balance Actual" 
                               TextColor="White" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Border>

            </StackLayout>

        </StackLayout>

        <!-- Elementos decorativos flotantes -->
        <Ellipse Grid.RowSpan="2" 
                 Fill="#FFFFFF" 
                 Opacity="0.1" 
                 WidthRequest="50" 
                 HeightRequest="50" 
                 HorizontalOptions="Start" 
                 VerticalOptions="Start" 
                 Margin="-10,60,0,0"
                 InputTransparent="True" />

        <Ellipse Grid.RowSpan="2" 
                 Fill="#FFFFFF" 
                 Opacity="0.1" 
                 WidthRequest="50" 
                 HeightRequest="50" 
                 HorizontalOptions="End" 
                 VerticalOptions="Start" 
                 Margin="0,180,-20,0"
                 InputTransparent="True" />

    </Grid>
</ContentPage>