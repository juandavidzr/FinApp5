<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.ListaCreditos"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="false">

    <Grid>
        <!-- Fondo con gradiente de morado a blanco -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6B63C6" Offset="0.0" />
                    <GradientStop Color="#9B94D8" Offset="0.25" />
                    <GradientStop Color="#C4C0E8" Offset="0.5" />
                    <GradientStop Color="#E8E6F5" Offset="0.75" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Contenido principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Avatar Section -->
            <StackLayout Grid.Row="0" Padding="0,20,0,8" HorizontalOptions="Center">
                <Frame WidthRequest="60" HeightRequest="60" CornerRadius="30" 
                       BackgroundColor="White" Padding="0" HasShadow="True"
                       BorderColor="#ffffff" Margin="0">
                    <Label Text="FA" FontSize="22" FontAttributes="Bold" 
                           TextColor="#5b64c3" HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"/>
                </Frame>
            </StackLayout>

            <!-- Title -->
            <Label Grid.Row="1" Text="Créditos" 
                   TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" Margin="0,0,0,8"/>

            <!-- Botones -->
            <Grid Grid.Row="2" ColumnSpacing="10" Padding="15,0,15,0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnTransacciones" 
                        Text="Ir a Transacciones" 
                        Clicked="btnTransacciones_Clicked"
                        BackgroundColor="#5b64c3"
                        TextColor="White"
                        FontSize="13"
                        Padding="0,10"
                        CornerRadius="20"
                        FontAttributes="Bold"
                        HeightRequest="38"/>
                <Button Grid.Column="1"
                        x:Name="btnInicio" 
                        Text="Ir a Menú Principal" 
                        Clicked="btnInicio_Clicked"
                        BackgroundColor="#5b64c3"
                        TextColor="White"
                        FontSize="13"
                        Padding="0,10"
                        CornerRadius="20"
                        FontAttributes="Bold"
                        HeightRequest="38"/>
            </Grid>

            <!-- SearchBar -->
            <Frame Grid.Row="3" Padding="0" CornerRadius="20" 
                   BackgroundColor="White" BorderColor="#cbd5e1" 
                   HasShadow="False" Margin="15,0,15,10" HeightRequest="40">
                <SearchBar Placeholder="Buscar" 
                           Keyboard="Chat"
                           TextChanged="SearchBar_TextChanged"
                           FontSize="14"
                           Background="Transparent"
                           TextColor="#1e293b"
                           PlaceholderColor="#94a3b8"
                           CancelButtonColor="#64748b"
                           VerticalOptions="Center"/>
            </Frame>

            <!-- Container blanco para lista -->
            <Frame Grid.Row="4" CornerRadius="25" Padding="0" 
                   BackgroundColor="White" HasShadow="True"
                   Margin="0,0,0,0">

                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Picker de ordenamiento -->
                    <Frame Grid.Row="0" Padding="0" CornerRadius="0" 
                           BackgroundColor="#eef2ff" BorderColor="Transparent" 
                           HasShadow="False" Margin="0">
                        <StackLayout Padding="12,8,12,8" Spacing="4">
                            <Label Text="ORDENAR POR:" FontSize="9" 
                                   TextColor="#64748b" FontAttributes="Bold"/>
                            <Picker x:Name="cmbOrden"
                                    ItemsSource="{Binding OrdenList}"
                                    ItemDisplayBinding="{Binding orden}"
                                    SelectedItem="{Binding id}"
                                    SelectedIndex="0"
                                    Title="Seleccione"
                                    FontSize="13"
                                    TextColor="#1e293b"
                                    SelectedIndexChanged="cmbOrden_SelectedIndexChanged"
                                    BackgroundColor="White"
                                    HeightRequest="35"/>
                        </StackLayout>
                    </Frame>

                    <!-- Encabezados -->
                    <Grid Grid.Row="1" Padding="15,10,15,8" BackgroundColor="#f1f5f9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna Izquierda -->
                        <StackLayout Grid.Column="0" Spacing="0">
                            <Label Text="ID"
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="Start"/>
                            <Label Text="NOMBRE" 
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="Start" Margin="0,2,0,0"/>
                            <Label Text="ID CRÉDITO"
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="Start"/>
                            <Label Text="SALDO"
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="Start"/>
                        </StackLayout>

                        <!-- Columna Derecha -->
                        <StackLayout Grid.Column="1" Spacing="0">
                            <Label Text="FECHA" 
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="End"/>
                            <Label Text="DÍA DE PAGO" 
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="End"/>
                            <Label Text="ÚLTIMO PAGO" 
                                   FontSize="9" TextColor="#64748b" FontAttributes="Bold"
                                   HorizontalTextAlignment="End" Margin="0,2,0,0"/>
                        </StackLayout>
                    </Grid>

                    <!-- Lista -->
                    <CollectionView x:Name="lstCreditos"
                                    Grid.Row="2"
                                    SelectionMode="Single"
                                    SelectionChanged="lstCreditos_SelectionChanged"
                                    BackgroundColor="White">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="0" Margin="10,4,10,4" 
                                       CornerRadius="12" 
                                       BackgroundColor="White"
                                       BorderColor="#e2e8f0"
                                       HasShadow="True">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Tapped="OnItemTapped"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <Grid Padding="15,10" RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- IZQUIERDA ARRIBA: ID Cliente / Nombre -->
                                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding idCliente}" 
                                                   TextColor="#3b82f6" FontSize="13" FontAttributes="Bold"/>
                                            <Label Text="{Binding nombreCliente}" 
                                                   TextColor="#0f172a" FontSize="12" FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"/>
                                        </StackLayout>

                                        <!-- DERECHA ARRIBA: Fecha / Día de Cobro -->
                                        <StackLayout Grid.Row="0" Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding fechaPrestamo}" 
                                                   TextColor="#0f172a" FontSize="11"
                                                   HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding desDiaPago}" 
                                                   TextColor="#0f172a" FontSize="11"
                                                   HorizontalTextAlignment="End"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"/>
                                        </StackLayout>

                                        <!-- IZQUIERDA ABAJO: ID Crédito / Saldo -->
                                        <StackLayout Grid.Row="1" Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding NumPrestamo}" 
                                                   TextColor="#0f172a" FontSize="11"/>
                                            <Label Text="{Binding cantidadPrestada, StringFormat='${0:N0}'}" 
                                                   TextColor="#dc2626" FontSize="13" FontAttributes="Bold"/>
                                        </StackLayout>

                                        <!-- DERECHA ABAJO: Último Pago -->
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding valUltPag, StringFormat='${0:N0}'}" 
                                               TextColor="#16a34a" FontSize="13" FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="End"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>