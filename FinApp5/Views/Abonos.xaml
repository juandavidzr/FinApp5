<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinApp5.Views.Abonos"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Shell.NavBarHasShadow="False"
             Shell.NavBarIsVisible="false">

    <Grid>
        <!-- Fondo con gradiente de morado a blanco -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6B63C6" Offset="0.0" />
                    <GradientStop Color="#9B94D8" Offset="0.25" />
                    <GradientStop Color="#C4C0E8" Offset="0.5" />
                    <GradientStop Color="#E8E6F5" Offset="0.75" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Contenido principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Avatar Section -->
            <StackLayout Grid.Row="0" Padding="0,30,0,10" HorizontalOptions="Center">
                <Frame WidthRequest="80" HeightRequest="80" CornerRadius="40" 
                       BackgroundColor="White" Padding="0" HasShadow="True"
                       BorderColor="#ffffff" Margin="0,0,0,5">
                    <Label Text="FA" FontSize="28" FontAttributes="Bold" 
                           TextColor="#5b64c3" HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"/>
                </Frame>
            </StackLayout>

            <!-- Botón Volver -->
            <Button Grid.Row="1" x:Name="btnVolver" 
                    Text="Volver a Créditos" 
                    Clicked="btnVolver_Clicked"
                    BackgroundColor="#5b64c3"
                    TextColor="White"
                    FontSize="16"
                    Padding="0,12"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    HeightRequest="45"
                    Margin="20,0,20,10"/>

            <!-- Container blanco para contenido -->
            <Frame Grid.Row="2" CornerRadius="35" Padding="0" 
                   BackgroundColor="White" HasShadow="True"
                   Margin="0,0,0,0">

                <ScrollView Margin="0">
                    <StackLayout Padding="20">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTapGestureRecognizerTapped"/>
                        </StackLayout.GestureRecognizers>

                        <!-- Título Sección Cliente -->
                        <Label Text="Información de el cliente" 
                               FontSize="18" FontAttributes="Bold" 
                               TextColor="#5b64c3" 
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,15"/>

                        <!-- Información del Cliente -->
                        <Grid RowSpacing="10" ColumnSpacing="10" Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ID -->
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="Id:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="0" Grid.Column="1" 
                                   x:Name="txtId" 
                                   FontSize="16" 
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Nombre -->
                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="Nombre:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="1" Grid.Column="1" 
                                   x:Name="txtNombre" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Dirección -->
                            <Label Grid.Row="2" Grid.Column="0" 
                                   Text="Dirección:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="2" Grid.Column="1" 
                                   x:Name="txtDireccion" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Botón Navegar -->
                            <Button Grid.Row="3" Grid.Column="1" 
                                    Text="Navegar" 
                                    Clicked="Navegar_Clicked"
                                    BackgroundColor="#3b82f6"
                                    TextColor="White"
                                    FontSize="14"
                                    Padding="0,10"
                                    CornerRadius="20"
                                    HeightRequest="40"/>

                            <!-- Teléfono -->
                            <Label Grid.Row="4" Grid.Column="0" 
                                   Text="Teléfono:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="4" Grid.Column="1" 
                                   x:Name="txtTelefono" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>
                        </Grid>

                        <!-- Botones de Acción: WhatsApp y Llamar -->
                        <Grid ColumnSpacing="10" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Text="WhatsApp" 
                                    Clicked="Button_WhatsApp"
                                    BackgroundColor="#25D366"
                                    TextColor="White"
                                    FontSize="15"
                                    Padding="0,12"
                                    CornerRadius="20"
                                    FontAttributes="Bold"
                                    HeightRequest="45"/>

                            <Button Grid.Column="1"
                                    Text="Llamar" 
                                    Clicked="Button_Clicked_Llamar"
                                    BackgroundColor="#0ea5e9"
                                    TextColor="White"
                                    FontSize="15"
                                    Padding="0,12"
                                    CornerRadius="20"
                                    FontAttributes="Bold"
                                    HeightRequest="45"/>
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" BackgroundColor="#e2e8f0" Margin="0,10,0,20"/>

                        <!-- Título Sección Crédito -->
                        <Label Text="Información del credito" 
                               FontSize="18" FontAttributes="Bold" 
                               TextColor="#5b64c3" 
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,15"/>

                        <!-- Información del Crédito -->
                        <Grid RowSpacing="10" ColumnSpacing="10" Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Id Crédito -->
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="Id Credito:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="0" Grid.Column="1" 
                                   x:Name="txtIdCredito" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Cuotas Atrasadas -->
                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="Cuotas Atrasadas:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="1" Grid.Column="1" 
                                   x:Name="txtAtrasadas" 
                                   FontSize="16" 
                                   TextColor="#dc2626"
                                   FontAttributes="Bold"
                                   BackgroundColor="#fee2e2"
                                   IsEnabled="False"/>

                            <!-- Fecha Crédito -->
                            <Label Grid.Row="2" Grid.Column="0" 
                                   Text="Fecha Credito:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" 
                                        x:Name="txtFechaCredito" 
                                        FontSize="16"
                                        BackgroundColor="#f1f5f9"
                                        IsEnabled="False"/>

                            <!-- Último Pago -->
                            <Label Grid.Row="3" Grid.Column="0" 
                                   Text="Ultimo Pago:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="3" Grid.Column="1" 
                                   x:Name="txtUltimoPago" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Valor Cuota -->
                            <Label Grid.Row="4" Grid.Column="0" 
                                   Text="Valor Cuota:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="4" Grid.Column="1" 
                                   x:Name="txtValorCuota" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Día (semana) -->
                            <Label Grid.Row="5" Grid.Column="0" 
                                   Text="Dia (semana):" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="5" Grid.Column="1" 
                                   x:Name="txtDia" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Cuotas Pendientes -->
                            <Label Grid.Row="6" Grid.Column="0" 
                                   Text="Cuotas pendientes:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="6" Grid.Column="1" 
                                   x:Name="txtCuotasPendientes" 
                                   FontSize="16"
                                   TextColor="#f59e0b"
                                   FontAttributes="Bold"
                                   BackgroundColor="#fef3c7"
                                   IsEnabled="False"/>

                            <!-- Saldo -->
                            <Label Grid.Row="7" Grid.Column="0" 
                                   Text="Saldo:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="7" Grid.Column="1" 
                                   x:Name="txtSaldo" 
                                   FontSize="16"
                                   TextColor="#dc2626"
                                   FontAttributes="Bold"
                                   BackgroundColor="#fee2e2"
                                   IsEnabled="False"/>

                            <!-- Total Crédito -->
                            <Label Grid.Row="8" Grid.Column="0" 
                                   Text="Total Credito:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="8" Grid.Column="1" 
                                   x:Name="txtTotal" 
                                   FontSize="16"
                                   BackgroundColor="#f1f5f9"
                                   IsEnabled="False"/>

                            <!-- Forma Pago -->
                            <Label Grid.Row="9" Grid.Column="0" 
                                   Text="Forma Pago:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Picker Grid.Row="9" Grid.Column="1" 
                                    x:Name="cmbFormaPago" 
                                    FontSize="16"
                                    BackgroundColor="#f1f5f9"
                                    IsEnabled="False"
                                    ItemsSource="{Binding formasPagos}" 
                                    ItemDisplayBinding="{Binding formaPago}"/>

                            <!-- Tipo de Abono -->
                            <Label Grid.Row="10" Grid.Column="0" 
                                   Text="Tipo de abono:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Picker Grid.Row="10" Grid.Column="1" 
                                    x:Name="cmbTipoAbono" 
                                    FontSize="16"
                                    BackgroundColor="White"
                                    IsEnabled="True" 
                                    ItemsSource="{Binding tiposAbonos}" 
                                    ItemDisplayBinding="{Binding tipoAbono}"
                                    SelectedItem="{Binding tipoAbono}"/>

                            <!-- Abono -->
                            <Label Grid.Row="11" Grid.Column="0" 
                                   Text="Abono:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="11" Grid.Column="1" 
                                   x:Name="txtAbono" 
                                   FontSize="16" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White"
                                   TextColor="#16a34a"
                                   FontAttributes="Bold"/>

                            <!-- Observaciones -->
                            <Label Grid.Row="12" Grid.Column="0" 
                                   Text="Observaciones:" 
                                   FontSize="16" TextColor="#475569" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   Margin="0,0,10,0"/>
                            <Entry Grid.Row="12" Grid.Column="1" 
                                   x:Name="txtObservaciones" 
                                   FontSize="16"
                                   BackgroundColor="White"/>
                        </Grid>

                        <!-- Botones de Acción -->
                        <Button x:Name="btnPagos" 
                                Text="Ver abonos" 
                                Clicked="btnPagos_Clicked"
                                BackgroundColor="#8b5cf6"
                                TextColor="White"
                                FontSize="16"
                                Padding="0,12"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                Margin="0,10,0,10"/>

                        <Button x:Name="btnGrabar" 
                                Text="Grabar" 
                                Clicked="btnGrabar_Clicked"
                                BackgroundColor="#5b64c3"
                                TextColor="White"
                                FontSize="18"
                                Padding="0,15"
                                CornerRadius="25"
                                FontAttributes="Bold"
                                HeightRequest="55"
                                Margin="0,0,0,10"/>

                        <Button x:Name="btnRetaque" 
                                Text="Retacar" 
                                Clicked="btnRetaque_Clicked"
                                BackgroundColor="#ef4444"
                                TextColor="White"
                                FontSize="16"
                                Padding="0,12"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                Margin="0,0,0,20"/>

                    </StackLayout>
                </ScrollView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
