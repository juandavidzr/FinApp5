<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinApp5.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinApp5"
    Shell.FlyoutBehavior="Disabled"
    xmlns:views="clr-namespace:FinApp5.Views"
    Title="FinApp5">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent Route="Transacciones" ContentTemplate="{DataTemplate views:Transacciones}" />


</Shell>
